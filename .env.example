# Reference only. The program reads process environment variables;
# it does not automatically load .env files.
# Copy values into your local shell environment or GitHub Actions Secrets.
# Never put real credentials in this example or public-journals.toml.

# Optional unless an OpenAlex subscription is enabled.
OPENALEX_API_KEY=

# Optional contact address for Crossref's polite pool.
# Prefer a dedicated address; do not publish your private email.
CROSSREF_MAILTO=
